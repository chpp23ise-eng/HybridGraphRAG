```gitignore
# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables and secrets
.env
.env.*
!.env.example

# IDE and OS files
.idea/
.vscode/
.DS_Store

# Generated databases and graph files
data/chroma_db/
data/knowledge_graph.pkl
data/extracted_images/
data/kg_visualization.html

# Node.js dependencies
node_modules/

# Logs and temporary files
*.log
*.tmp

# Jupyter
.ipynb_checkpoints/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Source documents and generated outputs
docs/
exports/
```